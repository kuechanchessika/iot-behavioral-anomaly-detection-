# IoT Defender — API Keys Config
# Copy this file to .env and fill in your real keys
# Never commit your real .env to GitHub!

# DeepSeek API (or OpenRouter key)
DEEPSEEK_API_KEY=your_deepseek_or_openrouter_key_here

# OpenAI (ChatGPT)
OPENAI_API_KEY=your_openai_key_here

# Anthropic (Claude)
CLAUDE_API_KEY=your_claude_key_here
